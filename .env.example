REACTOR_API_KEY=replace_with_your_reactor_api_key
# Optional. Without a real key here, Gemini features (rewriting, suggestions,
# image drafting) are served by the hosted site, so you don't need one to run locally.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Optional. off = never use the hosted site; always = use it even with a key; or a URL.
ADTRACTIVE_HOSTED_AI=
# Optional. When set, starting a live session asks for this password once per browser session.
STUDIO_PASSWORD=
