# Required: Reactor API key with access to Visko Orbis Stable.
REACTOR_API_KEY=replace_with_your_reactor_api_key

# The lab needs ONE model provider for start-frame generation, grounded episode
# planning, and closed-loop cue checking. Set either key — OpenAI is preferred
# when both are present. Without either, the lab still runs on catalog phase
# prompts and text-to-video.
OPENAI_API_KEY=replace_with_your_openai_api_key
# GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional. Force a provider regardless of which keys are set.
# LAB_PROVIDER=openai

# Optional model pins. Each provider already falls back newest-to-oldest.
# LAB_IMAGE_MODEL=gpt-image-1.5
# LAB_TEXT_MODEL=gpt-5-mini
