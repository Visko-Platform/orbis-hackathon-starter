# Optional shared presenter credentials. Never commit real keys.
REACTOR_API_KEY=
NEBIUS_API_KEY=
# Required when shared provider keys above are used; enter in Connections.
LIVE_ACCESS_CODE=
REACTOR_MODEL=reactor/visko-orbis-dynamic
NEBIUS_MODEL=openai/gpt-oss-120b

# Atomic shared-provider limits across all browsers (per hour).
SHARED_REACTOR_HOURLY_LIMIT=12
SHARED_NEBIUS_HOURLY_LIMIT=120
